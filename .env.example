# Flask App Secrets
SECRET_KEY=replace-with-a-very-strong-secret-key-32-chars
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration (Leave empty for SQLite, or configure MySQL)
# SQLite (Default Out-of-the-Box):
DATABASE_URL=sqlite:///student_erp.db

# MySQL Production Format:
# DATABASE_URL=mysql+pymysql://erp_user:your_secure_password@127.0.0.1:3306/student_erp?charset=utf8mb4

# Institutional Branding
INSTITUTION_NAME=Apex Institute of Higher Education & Technology
INSTITUTION_CODE=AIHET-2026
